{
  "schema_version": 1,
  "document": "Golden Resume content-length stress matrix",
  "baseline": {
    "source": "tests/fixtures/golden-resume/golden-resume.typ",
    "data": "tests/fixtures/golden-resume/golden-resume-data.json",
    "renderer": "tests/fixtures/golden-resume/golden-resume-template.typ",
    "oracle": "tests/fixtures/golden-resume/golden-resume-oracle.json",
    "sha256": {
      "source": "ab3b113f5c4b1bbaabe6f78c6029297a8eff90bc6fc22adb571e0a9cc46fd1bd",
      "data": "31937c62bab103ec282aed6e6227f6e3c9d703f03fbb00d287bfb82340b2b092",
      "renderer": "ba98322de965067a6c9480fa3a157bce7fec7108216fd54a6b927d42d60007bb",
      "oracle": "ece4cf3e913cfadb60c8eb124f71f65d74bde91f7255742c6493d4a375ff5cc8"
    }
  },
  "cases": [
    {
      "name": "baseline",
      "description": "Canonical Golden content through the reusable renderer.",
      "expectation": "pass",
      "mutations": []
    },
    {
      "name": "long-company",
      "description": "A realistic long legal employer name increases left-side row pressure.",
      "expectation": "pass",
      "mutations": [{"subject": "northstar-experience", "field": "company", "value": "International Commerce Infrastructure Group, Inc."}]
    },
    {
      "name": "long-title",
      "description": "A long senior title increases left-side row pressure without changing other facts.",
      "expectation": "pass",
      "mutations": [{"subject": "northstar-experience", "field": "role", "value": "Senior Principal Site Reliability Engineer"}]
    },
    {
      "name": "long-location",
      "description": "A long but plausible location increases right-side metadata pressure.",
      "expectation": "pass",
      "mutations": [{"subject": "cedar-experience", "field": "location", "value": "Washington, District of Columbia"}]
    },
    {
      "name": "long-dates",
      "description": "Verbose month-level dates increase right-side metadata pressure.",
      "expectation": "pass",
      "mutations": [{"subject": "cedar-experience", "field": "dates", "value": "September 2016 - November 2019"}]
    },
    {
      "name": "long-urls",
      "description": "Long canonical portfolio, GitHub, and LinkedIn values stress the centered contact row.",
      "expectation": "pass",
      "mutations": [
        {"subject": "contact-portfolio", "field": "display", "value": "alexandra-morgan.engineering/portfolio"},
        {"subject": "contact-portfolio", "field": "uri", "value": "https://alexandra-morgan.engineering/portfolio"},
        {"subject": "contact-github", "field": "display", "value": "github.com/alexandra-morgan-engineering"},
        {"subject": "contact-github", "field": "uri", "value": "https://github.com/alexandra-morgan-engineering"},
        {"subject": "contact-linkedin", "field": "display", "value": "linkedin.com/in/alexandra-morgan-engineering"},
        {"subject": "contact-linkedin", "field": "uri", "value": "https://www.linkedin.com/in/alexandra-morgan-engineering"}
      ]
    },
    {
      "name": "long-project-metadata",
      "description": "Long project name, descriptor, and focus stress both sides of the project row.",
      "expectation": "pass",
      "mutations": [
        {"subject": "kubernetes-project", "field": "name", "value": "Distributed Kubernetes Operations Platform"},
        {"subject": "kubernetes-project", "field": "descriptor", "value": "Independent Infrastructure Engineering Project"},
        {"subject": "kubernetes-project", "field": "focus", "value": "Talos Linux, Flux, Cilium, Prometheus, and Longhorn"}
      ]
    },
    {
      "name": "combined-metadata-pressure",
      "description": "Long left and right experience values expose interaction failures after isolated cases.",
      "expectation": "pass",
      "mutations": [
        {"subject": "northstar-experience", "field": "company", "value": "International Commerce Infrastructure Group, Inc."},
        {"subject": "northstar-experience", "field": "role", "value": "Senior Principal Site Reliability Engineer"},
        {"subject": "northstar-experience", "field": "dates", "value": "September 2017 - Present"},
        {"subject": "northstar-experience", "field": "location", "value": "Washington, District of Columbia"}
      ]
    },
    {
      "name": "unbreakable-location-boundary",
      "description": "An intentionally unsupported unbroken location token proves right-side overflow is detected.",
      "expectation": "fail",
      "expected_failed_gates": ["all_text_views", "right_metadata_geometry"],
      "mutations": [{"subject": "cedar-experience", "field": "location", "value": "WashingtonDistrictOfColumbiaBaltimoreNorthernVirginiaMetropolitanRegionAndRemoteAcrossTheUnitedStates"}]
    },
    {
      "name": "unbreakable-company-boundary",
      "description": "An intentionally unsupported unbroken employer token proves horizontal overflow is detected.",
      "expectation": "fail",
      "expected_failed_gates": ["all_text_views", "right_metadata_geometry"],
      "mutations": [{"subject": "northstar-experience", "field": "company", "value": "InternationalCommerceInfrastructureOperationsAndReliabilityEngineeringConsortiumHoldingsCorporationIncorporated"}]
    }
  ]
}
